{
  "name": "codey-monorepo",
  "private": true,
  "version": "0.12.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Codey \u2014 a multi-agent workbench and control plane for coding agents (Claude Code, Codex, OpenCode, pi): per-project workspaces, worker teams, parallel runs, and access from a macOS app, Telegram/Discord/iMessage, or voice.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/its-ahoh/codey.git"
  },
  "workspaces": [
    "packages/*",
    "codey-mac"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "lint": "node scripts/check-non-english.mjs",
    "build:core": "npm run build -w @codey/core",
    "build:gateway": "npm run build -w @codey/gateway",
    "dev": "npm run dev -w @codey/gateway",
    "start": "npm run start -w @codey/gateway",
    "configure": "npm run configure -w @codey/gateway",
    "status": "npm run status -w @codey/gateway",
    "set-agent": "npm run set-agent -w @codey/gateway",
    "set-model": "npm run set-model -w @codey/gateway",
    "tui": "npm run tui -w @codey/gateway",
    "verify-workers": "npm run build && ts-node scripts/verify-workers.ts",
    "verify-gateway": "npm run build && ts-node scripts/verify-gateway.ts",
    "api-token": "npm run api-token -w @codey/gateway --"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "coding-agent",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "ai-coding-assistant",
    "developer-tools",
    "llm",
    "mcp",
    "telegram-bot",
    "discord-bot",
    "imessage",
    "macos",
    "electron",
    "typescript",
    "automation",
    "voice-input",
    "whisper"
  ],
  "homepage": "https://its-ahoh.github.io/codey/"
}
